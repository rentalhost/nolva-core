{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "baseUrl": "./dist",
    "target": "esnext",
    "loose": true,
    "minify": {
      "mangle": true,
      "compress": {
        "defaults": true,
        "arguments": true
      }
    },
    "paths": { "#/*": ["./*"] }
  },
  "test": ".*\\.js$",
  "minify": true
}

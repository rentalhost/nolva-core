{
  "name": "@rentalhost/rheactor-core",
  "version": "1.1.0",
  "private": true,
  "description": "Rheactor core functions.",
  "license": "Apache License 2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": [
      "./src/*"
    ],
    "#Tests/*": [
      "./tests/*"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    }
  },
  "scripts": {
    "build": "rimraf ./dist && tspc -p ./tsconfig.build.json && swc ./dist -d .",
    "lint": "npm run typecheck && npm run eslint && npm run oxfmt",
    "lint:fix": "npm run typecheck && npm run eslint:fix && npm run oxfmt:fix",
    "typecheck": "tsc --noEmit",
    "oxfmt": "oxfmt --check ./src ./tests",
    "oxfmt:fix": "oxfmt --write ./src ./tests",
    "eslint": "eslint ./src ./tests",
    "eslint:fix": "eslint --fix ./src ./tests",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@rheactor/eslint-config-rheactor": "github:rheactor/eslint-config-rheactor",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "next": "^16.2.10",
    "oxfmt": "^0.59.0",
    "rimraf": "^6.1.3",
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3",
    "typescript-transform-paths": "^4.0.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "next": "^16.2.10"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
